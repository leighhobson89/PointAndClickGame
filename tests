#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');
const { recordVideoRun } = require('./scripts/run-history.cjs');

const ROOT = __dirname;
const E2E_ROOT = path.join(ROOT, 'e2e');
const LOG_ROOT = path.join(E2E_ROOT, 'logs');
const FULL_SUITE_LIMIT_MS = 180_000;
const MAX_TARGETED_AREAS = 3;
const IGNORED_DIRECTORIES = new Set(['_support', 'logs']);
const VIDEO_MODES = new Set(['on', 'retain-on-failure', 'on-first-retry', 'off']);

function availableAreas() {
    return fs.readdirSync(E2E_ROOT, { withFileTypes: true })
        .filter((entry) => entry.isDirectory() && !IGNORED_DIRECTORIES.has(entry.name))
        .map((entry) => entry.name)
        .sort();
}

function fail(message, code = 1) {
    console.error(message);
    process.exit(code);
}

function readLatestFullRun() {
    const file = path.join(LOG_ROOT, 'latest-full-suite.json');
    if (!fs.existsSync(file)) return null;

    try {
        return JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch (error) {
        fail(`Cannot read ${path.relative(ROOT, file)}: ${error.message}`);
    }
}

function safeTimestamp(date) {
    return date.toISOString().replace(/[:.]/g, '-');
}

const rawArgs = process.argv.slice(2);
const areas = availableAreas();

// --video records every test; --video=<mode> passes a Playwright video mode
// through, so --video=retain-on-failure keeps only the failures.
let videoMode = 'off';
const args = rawArgs.filter((argument) => {
    if (argument !== '--video' && !argument.startsWith('--video=')) return true;
    videoMode = argument === '--video' ? 'on' : argument.slice('--video='.length);
    return false;
});

if (!VIDEO_MODES.has(videoMode)) {
    fail(`Unknown video mode '${videoMode}'. Use one of: ${[...VIDEO_MODES].join(', ')}.`, 2);
}
const recordingVideo = videoMode !== 'off';

if (args.length === 0 || args.includes('--help') || args.includes('-h')) {
    console.log('Usage: node tests all | node tests <functionalArea> [functionalArea2 functionalArea3] [--video[=mode]]');
    console.log(`Functional areas: ${areas.join(', ')}`);
    console.log('');
    console.log('  --video                 record video for every test in the run');
    console.log(`  --video=<mode>          Playwright video mode: ${[...VIDEO_MODES].join(', ')}`);
    console.log('');
    console.log('Recorded runs keep their own Playwright report and artefacts under test-reports/,');
    console.log('and are listed newest-first in test-reports/history.html with a player for each video.');
    process.exit(args.length === 0 ? 1 : 0);
}

const isFullSuite = args.length === 1 && args[0] === 'all';
let selectedAreas;

if (isFullSuite) {
    const lastRun = readLatestFullRun();
    if (lastRun && Number(lastRun.durationMs) >= FULL_SUITE_LIMIT_MS) {
        fail(
            `Full suite blocked: the last full run took ${lastRun.durationSeconds}s ` +
            `(limit: ${FULL_SUITE_LIMIT_MS / 1000}s). Run up to ${MAX_TARGETED_AREAS} named areas instead.`,
            2,
        );
    }
    selectedAreas = areas;
} else {
    if (args.length > MAX_TARGETED_AREAS) {
        fail(`Choose at most ${MAX_TARGETED_AREAS} functional areas per targeted run.`, 2);
    }

    const unknown = args.filter((area) => !areas.includes(area));
    if (unknown.length > 0) {
        fail(`Unknown functional area(s): ${unknown.join(', ')}. Available: ${areas.join(', ')}`, 2);
    }
    selectedAreas = args;
}

fs.mkdirSync(LOG_ROOT, { recursive: true });

const startedAt = new Date();
const scope = isFullSuite ? 'all' : selectedAreas.join('+');
const runId = `${safeTimestamp(startedAt)}-${scope}`;
const targets = selectedAreas.map((area) => area.replaceAll('\\', '/'));
const playwrightCli = require.resolve('@playwright/test/cli');

if (recordingVideo) {
    console.log(`Recording video (${videoMode}) for run ${runId}.`);
}

const result = spawnSync(process.execPath, [playwrightCli, 'test', ...targets], {
    cwd: ROOT,
    encoding: 'utf8',
    env: {
        ...process.env,
        FORCE_COLOR: '0',
        E2E_VIDEO: videoMode,
        // Only a recorded run gets its own folders; ordinary runs keep the
        // single shared report and artefact directories.
        ...(recordingVideo ? { E2E_RUN_ID: runId } : {}),
    },
});
const endedAt = new Date();
const durationMs = endedAt.getTime() - startedAt.getTime();
const exitCode = Number.isInteger(result.status) ? result.status : 1;
const status = exitCode === 0 ? 'passed' : 'failed';
const logName = `${runId}.log`;
const logPath = path.join(LOG_ROOT, logName);
const combinedOutput = [result.stdout, result.stderr].filter(Boolean).join('\n');

process.stdout.write(result.stdout || '');
process.stderr.write(result.stderr || '');

const summary = {
    schemaVersion: 2,
    runId,
    scope,
    areas: selectedAreas,
    startedAt: startedAt.toISOString(),
    endedAt: endedAt.toISOString(),
    durationMs,
    durationSeconds: Number((durationMs / 1000).toFixed(3)),
    fullSuiteLimitSeconds: FULL_SUITE_LIMIT_MS / 1000,
    status,
    exitCode,
    video: videoMode,
    logFile: path.relative(ROOT, logPath).replaceAll('\\', '/'),
    reportDirectory: (recordingVideo ? `test-reports/runs/${runId}` : 'playwright-report'),
};

let history = null;
if (recordingVideo) {
    history = recordVideoRun(ROOT, summary, path.join(ROOT, 'test-reports', 'artifacts', runId));
    summary.videoCount = history.videos.length;
    summary.videoIndex = history.indexPath;
    summary.videos = history.videos.map((video) => video.file);
}

fs.writeFileSync(logPath, `${JSON.stringify(summary, null, 2)}\n\n${combinedOutput}`, 'utf8');
fs.writeFileSync(
    path.join(LOG_ROOT, isFullSuite ? 'latest-full-suite.json' : 'latest-targeted-run.json'),
    `${JSON.stringify(summary, null, 2)}\n`,
    'utf8',
);

console.log(`\n${status.toUpperCase()} in ${summary.durationSeconds}s. Log: ${summary.logFile}`);
if (history) {
    console.log(`Report: ${summary.reportDirectory}/index.html`);
    console.log(`Recorded ${history.videos.length} video(s). History: ${history.indexPath}`);
}
process.exit(exitCode);
