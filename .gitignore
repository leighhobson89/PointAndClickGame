# Dependencies
node_modules/

# Generated builds and packaged desktop output
builds/
dist/
release/
out/
pointAndClickDesktop/

# Playwright and test output
playwright-report/
test-results/
blob-report/
e2e/logs/*.log
e2e/logs/*.json
!e2e/logs/.gitkeep

# Runtime and package-manager logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# Temporary and cache files
*.tmp
*.temp
.cache/
coverage/

# Python utility caches
__pycache__/
*.py[cod]

# Editor and operating-system clutter
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Keep the shared VS Code launch configuration, but ignore personal settings.
.vscode/*
!.vscode/launch.json
