{
    "name": "point-and-click-game",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "start:debug": "node scripts/start-debug.cjs",
        "test": "node tests all",
        "test:e2e": "node tests all",
        "test:video": "node tests all --video",
        "test:unit": "node --test test/unit/*.test.mjs",
        "validate:content": "node scripts/validate-content.mjs",
        "report:hotspots": "node scripts/validate-content.mjs --report-hotspots",
        "report:assets": "node scripts/asset-manifest.mjs",
        "check:assets": "node scripts/asset-manifest.mjs --check",
        "report:art": "node scripts/art-calibration.mjs all",
        "check:dependencies": "node scripts/check-dependencies.mjs",
        "check": "npm run check:dependencies && npm run validate:content && npm run test:unit",
        "pretest": "npm run validate:content"
    },
    "dependencies": {
        "electron": "^33.0.2",
        "electron-builder": "^25.1.8",
        "express": "^4.18.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0"
    }
}
