{
    "name": "point-and-click-game",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "node tests all",
        "test:e2e": "node tests all",
        "test:unit": "node --test test/unit/*.test.mjs",
        "validate:content": "node scripts/validate-content.mjs",
        "report:hotspots": "node scripts/validate-content.mjs --report-hotspots",
        "check": "npm run validate:content && npm run test:unit",
        "pretest": "npm run validate:content"
    },
    "dependencies": {
        "electron": "^33.0.2",
        "electron-builder": "^25.1.8",
        "express": "^4.18.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0"
    }
}
